# Shopify Storefront API credentials.
# Copy this file to `.env` and fill in real values when you have them.
# These are PUBLIC because Astro exposes any var prefixed with PUBLIC_ to the browser.
# The Storefront API token is safe to expose; it's read-only and rate-limited by Shopify.

PUBLIC_SHOPIFY_STORE_DOMAIN=purest-electrolyte.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Contact form email delivery (server-only). Use Resend OR SMTP.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Purest Website <drink@purestelectrolyte.com>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Meta (Facebook / Instagram) visitor tracking.
# The pixel id is public. Leave it blank to use the Purest Electrolyte dataset.
# PUBLIC_FB_DOMAIN_VERIFICATION is the code Meta gives you for the domain meta tag.
# META_CAPI_ACCESS_TOKEN is a secret. Put it in Vercel only — never commit a real token.
# META_CAPI_TEST_EVENT_CODE is optional and only for Events Manager test events. Remove it after testing.
PUBLIC_META_PIXEL_ID=
PUBLIC_FB_DOMAIN_VERIFICATION=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
