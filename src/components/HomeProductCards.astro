---
import { getReviewSummary } from "@/lib/reviews";
import type { Product } from "@/lib/shopify";

interface Frame {
  l: number;
  t: number;
  r: number;
  b: number;
}

interface Item {
  product: Product;
  name: string;
  href: string;
  fit?: "cover" | "pack";
  frame?: Frame;
  /** Fraction of the tile the framed subject should fill. Flavors use the glass height. */
  target?: number;
  alsoProductIds?: string[];
}

const { items, place = "start" } = Astro.props as { items: Item[]; place?: "start" | "center" };

function packStyle(frame: Frame, target = 0.74) {
  const height = frame.b - frame.t;
  const cx = (frame.l + frame.r) / 2;
  const cy = (frame.t + frame.b) / 2;
  const scale = target / height;
  const size = scale * 100;
  const left = (0.5 - cx * scale) * 100;
  const top = (0.5 - cy * scale) * 100;
  return `width:${size.toFixed(2)}%;height:${size.toFixed(2)}%;left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`;
}

/** Map a source window onto the same inset every lifestyle tile uses. */
function coverStyle(frame: Frame) {
  const winW = frame.r - frame.l;
  const winH = frame.b - frame.t;
  const inner = 0.86;
  const inset = (1 - inner) / 2;
  const width = (inner / winW) * 100;
  const height = (inner / winH) * 100;
  const left = (inset - frame.l * (inner / winW)) * 100;
  const top = (inset - frame.t * (inner / winH)) * 100;
  return `width:${width.toFixed(2)}%;height:${height.toFixed(2)}%;left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`;
}

const cards = await Promise.all(
  items.map(async (item) => {
    const review = await getReviewSummary(item.product.id, item.alsoProductIds ?? []);
    const rated = review && review.count > 0 ? review : null;
    return {
      href: item.href,
      name: item.name,
      image: item.product.image,
      fit: item.fit ?? "pack",
      frame: item.frame,
      target: item.target,
      rating: rated?.average ?? null,
      count: rated?.count ?? null,
    };
  }),
);
---

<ul class="grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-5 lg:gap-x-6">
  {cards.map((card, index) => {
    const centerOnPhone = cards.length % 2 === 1 && index === cards.length - 1;
    const imageStyle = card.frame
      ? card.fit === "cover"
        ? coverStyle(card.frame)
        : packStyle(card.frame, card.target)
      : undefined;
    return (
      <li class:list={[
        centerOnPhone && "col-span-2 flex justify-center lg:col-span-1 lg:block",
        place === "center" && index === 0 && "lg:col-start-2",
      ]}>
        <a href={card.href} class:list={["flex h-full w-full flex-col text-center", centerOnPhone && "max-w-[calc(50%-0.5rem)] lg:max-w-none"]}>
          <span class="relative block aspect-square w-full overflow-hidden bg-[#fafafa] ring-1 ring-inset ring-black/10">
            {card.image ? (
              <img
                src={card.image.url}
                alt={card.image.altText ?? card.name}
                class:list={["absolute max-w-none", card.fit === "cover" && "object-cover"]}
                style={imageStyle}
                loading="eager"
              />
            ) : (
              <span class="block h-full w-full" />
            )}
          </span>
          <span class="mt-2 line-clamp-2 min-h-[2.25rem] font-serif text-sm leading-tight tracking-tight md:min-h-[2.5rem] md:text-base">
            {card.name}
          </span>
          <span class="mt-1 flex h-3.5 items-center justify-center" aria-label={card.rating !== null && card.count !== null ? `${card.rating} out of 5 stars from ${card.count} reviews` : undefined}>
            {card.rating !== null && (
              <span class="inline-flex text-foreground" aria-hidden="true">
                {[0, 1, 2, 3, 4].map((star) => {
                  const amount = Math.min(1, Math.max(0, card.rating! - star));
                  const id = `${card.href}-${star}`.replace(/[^a-z0-9-]/gi, "");
                  return (
                    <svg viewBox="0 0 20 20" class="h-3.5 w-3.5">
                      <defs>
                        <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
                          <stop offset={`${amount * 100}%`} stop-color="currentColor" />
                          <stop offset={`${amount * 100}%`} stop-color="transparent" />
                        </linearGradient>
                      </defs>
                      <path d="M10 1.7 12.2 7.1l5.8.5-4.4 3.8 1.4 5.6L10 14.2 4.9 17l1.4-5.6L1.9 7.6l5.8-.5L10 1.7Z" fill={`url(#${id})`} stroke="currentColor" stroke-width="1" />
                    </svg>
                  );
                })}
              </span>
            )}
          </span>
        </a>
      </li>
    );
  })}
</ul>
