---
import { getReviewSummary } from "@/lib/reviews";
import type { Product } from "@/lib/shopify";

interface Item {
  product: Product;
  name: string;
  href: string;
}

const { items, columns = "five" } = Astro.props as { items: Item[]; columns?: "five" | "three" };

const cards = await Promise.all(
  items.map(async (item) => {
    const review = await getReviewSummary(item.product.id);
    const rated = review && review.count > 0 ? review : null;
    return {
      href: item.href,
      name: item.name,
      image: item.product.image,
      rating: rated?.average ?? null,
      count: rated?.count ?? null,
    };
  }),
);
---

<ul class:list={["grid grid-cols-2 gap-x-4 gap-y-10", columns === "five" ? "lg:grid-cols-5 lg:gap-x-6" : "lg:grid-cols-3 lg:gap-x-8"]}>
  {cards.map((card) => (
    <li>
      <a href={card.href} class="group block text-center">
        <span class="block aspect-square overflow-hidden bg-white">
          {card.image ? (
            <img
              src={card.image.url}
              alt={card.image.altText ?? card.name}
              class="h-full w-full object-contain"
              loading="eager"
            />
          ) : (
            <span class="block h-full w-full" />
          )}
        </span>
        <span class="mt-4 block font-serif text-lg tracking-tight">{card.name}</span>
        {card.rating !== null && card.count !== null && (
          <span class="mt-2 flex items-center justify-center gap-1" aria-label={`${card.rating} out of 5 stars from ${card.count} reviews`}>
            <span class="inline-flex text-foreground" aria-hidden="true">
              {[0, 1, 2, 3, 4].map((index) => {
                const amount = Math.min(1, Math.max(0, card.rating! - index));
                const id = `${card.href}-${index}`.replace(/[^a-z0-9-]/gi, "");
                return (
                  <svg viewBox="0 0 20 20" class="h-3.5 w-3.5">
                    <defs>
                      <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
                        <stop offset={`${amount * 100}%`} stop-color="currentColor" />
                        <stop offset={`${amount * 100}%`} stop-color="transparent" />
                      </linearGradient>
                    </defs>
                    <path d="M10 1.7 12.2 7.1l5.8.5-4.4 3.8 1.4 5.6L10 14.2 4.9 17l1.4-5.6L1.9 7.6l5.8-.5L10 1.7Z" fill={`url(#${id})`} stroke="currentColor" stroke-width="1" />
                  </svg>
                );
              })}
            </span>
          </span>
        )}
      </a>
    </li>
  ))}
</ul>
