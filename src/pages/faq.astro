---
import Layout from "@/layouts/Layout.astro";
import SeaSaltTestingArticle from "@/components/SeaSaltTestingArticle.astro";

const faqs = [
  {
    q: "Is your sea salt tested for heavy metals?",
    a: "Yes. The certificate we share for our French sea salt reports lead at 0.57 ppm, arsenic at 0.06 ppm, cadmium at less than 0.01 ppm and mercury at less than 0.005 ppm. All four results were below the limits listed on the certificate. The full report below includes the analysis and certificate dates.",
    featured: true,
    id: "sea-salt-testing"
  },
  {
    q: "What should I look for in a clean sea salt electrolyte?",
    a: "Look at the ingredient list and the actual test results. Purest combines French gray sea salt with real freeze dried fruit. Ingredients vary by flavor and are listed on each product page. Our published sea salt analysis gives the exact heavy metal results for the ingredient listed in that certificate.",
    testingLink: true
  },
  {
    q: "What's in Purest Electrolyte?",
    a: "Purest is made with organic freeze-dried real fruit, natural sun-dried French gray sea salt, and a short list of clearly labeled plant-derived ingredients that vary by flavor. You can see every ingredient in the jar."
  },
  {
    q: "How is Purest different from other electrolytes?",
    a: "Most electrolytes use only 3 synthetic minerals. Purest delivers 85+ trace minerals naturally occurring in sun-dried sea salt, paired with real freeze-dried fruit for glucose-assisted absorption. No lab-made ingredients. No hidden additives."
  },
  {
    q: "Are your fruit powders organic?",
    a: "Yes. All of our fruit powders are organic, so we do not use conventionally grown fruit powders with pesticide applications. All of our fruit is freeze-dried and is not sprayed with maltodextrin."
  },
  {
    q: "Do you use anti-caking agents?",
    a: "No. We do not add any anti-caking agents."
  },
  {
    q: "Do you test your sea salt for microplastics?",
    a: "Microplastics are not part of the testing performed by our salt farmer, so we do not claim that our sea salt is tested for microplastics."
  },
  {
    q: "Where does your citric acid come from?",
    a: "Our citric acid is derived from cassava root, not mold."
  },
  {
    q: "How do I use it?",
    a: "Mix one serving in 8-16 oz of water and drink. You can use it before, during, or after activity — or any time you need to hydrate. Many people love it first thing in the morning."
  },
  {
    q: "How much sodium is in each serving?",
    a: "700+ mg of naturally occurring sodium from French gray sea salt per serving. This is naturally occurring sodium — not processed or synthetic."
  },
  {
    q: "Is there added sugar, and are stevia and monk fruit artificial sweeteners?",
    a: "Purest has no added sugar. Stevia and monk fruit are plant-derived sweeteners, not artificial sweeteners."
  },
  {
    q: "Can kids drink it?",
    a: "Purest is made with clean, natural ingredients. Many parents use it for their active kids. We recommend consulting your pediatrician if you have questions about your child's specific needs."
  },
  {
    q: "How should I store it?",
    a: "Store in a cool, dry place away from direct sunlight. Keep the jar sealed when not in use."
  },
  {
    q: "Do you offer subscriptions?",
    a: "Yes! Subscribe & Save 10% on monthly deliveries. Never run out of your favorite flavor. Cancel anytime."
  },
  {
    q: "What is your return policy?",
    a: "We stand behind Purest 100%. If you're not satisfied with your purchase, send us a message through the Contact page and we'll make it right."
  },
  {
    q: "Where is Purest developed?",
    a: "Purest was developed and tested at 8,900 feet in Aspen, Colorado — by Pam Sweeney and her four high-level athlete kids who needed real hydration at altitude."
  },
];
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "@id": "https://www.purestelectrolyte.com/faq#questions",
  mainEntity: faqs.slice(0, 2).map((faq) => ({
    "@type": "Question", name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a }
  }))
};
---

<Layout title="Sea Salt Testing and Electrolyte FAQs | Purest" canonical="https://www.purestelectrolyte.com/faq" description="See Purest’s French sea salt heavy metal test results and answers about ingredients, sodium, sourcing and how to use our real fruit electrolyte.">
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <section class="container py-16 md:py-20 max-w-3xl">
    <header>
      <p class="text-xs uppercase tracking-widest text-muted-foreground">Help</p>
      <h1 class="mt-4 font-serif text-4xl tracking-tight">Frequently Asked Questions</h1>
      <p class="mt-4 text-muted-foreground">Have a question? <a href="/contact" class="underline underline-offset-2">Contact us</a> and we'll be happy to help.</p>
    </header>

    <div class="mt-12 divide-y divide-border">
      {faqs.map((faq) => (
        <details id={faq.id} open={faq.featured} class="group py-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-lg tracking-tight list-none">
            {faq.q}
            <span class="text-muted-foreground transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-muted-foreground leading-relaxed">{faq.a}</p>
          {(faq.featured || faq.testingLink) && (
            <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              <a href="/science/sea-salt-heavy-metal-test-results" class="underline underline-offset-4">Read the Science article</a>
              <a href="#sea-salt-full-report" class="underline underline-offset-4" data-open-salt-report>Read the full report on this page</a>
            </p>
          )}
        </details>
      ))}
    </div>
    <section id="sea-salt-full-report" class="mt-14 border-t border-border pt-10 scroll-mt-24">
      <h2 class="font-serif text-2xl tracking-tight md:text-3xl">Our sea salt sourcing and test results</h2>
      <p class="mt-4 text-muted-foreground leading-relaxed">Read the full article here, including our visit to Guérande, France, and the complete sea salt certificate summary.</p>
      <details id="salt-report-details" class="mt-6">
        <summary class="cursor-pointer rounded-lg border border-border bg-secondary px-5 py-4 font-medium">View the full sea salt article and certificate</summary>
        <div class="mt-8"><SeaSaltTestingArticle idPrefix="faq-sea-salt" /></div>
      </details>
    </section>
  </section>
</Layout>

<script>
  document.querySelectorAll('[data-open-salt-report]').forEach((link) => {
    link.addEventListener('click', () => {
      const report = document.getElementById('salt-report-details') as HTMLDetailsElement | null;
      if (report) report.open = true;
    });
  });
</script>
