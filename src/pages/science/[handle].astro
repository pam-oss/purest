---
import Layout from "@/layouts/Layout.astro";
import { getArticle, getBlogArticles } from "@/lib/shopify";

export async function getStaticPaths() {
  const articles = await getBlogArticles("science");
  return articles.map((a) => ({ params: { handle: a.handle } }));
}

const { handle } = Astro.params;
const article = await getArticle("science", handle!);
if (!article) return Astro.redirect("/science");
const description = article.contentHtml.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim().slice(0, 155);
const canonical = `https://www.purestelectrolyte.com/science/${handle}`;
const articleSchema = {
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: article.title, description, mainEntityOfPage: canonical,
  datePublished: article.publishedAt,
  author: { "@type": "Organization", name: "Purest Electrolyte", url: "https://www.purestelectrolyte.com/about" },
  publisher: { "@type": "Organization", name: "Purest Electrolyte", url: "https://www.purestelectrolyte.com" },
  ...(article.image ? { image: [article.image.url] } : {})
};
---

<Layout title={`${article.title} · Purest Electrolyte`} description={description} type="article" publishedTime={article.publishedAt} {...(article.image ? { image: article.image.url } : {})}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")} />
  </Fragment>
  <section class="container py-16 md:py-20 max-w-3xl">
    <a href="/science" class="text-sm text-muted-foreground hover:text-foreground mb-8 inline-block">← The Science</a>
    {article.image && (
      <div class="mb-8 aspect-video overflow-hidden rounded-xl bg-stone-100">
        <img src={article.image.url} alt={article.image.altText ?? article.title} class="h-full w-full object-cover" />
      </div>
    )}
    <p class="text-xs text-muted-foreground">{new Date(article.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</p>
    <h1 class="mt-3 font-serif text-3xl tracking-tight md:text-4xl">{article.title}</h1>
    <div class="mt-8 prose prose-stone max-w-none" set:html={article.contentHtml} />
    <div class="mt-16 border-t border-border pt-8">
      <p class="mb-4 text-sm leading-relaxed"><a href="/science/sea-salt-heavy-metal-test-results" class="underline underline-offset-4">See our French sea salt sourcing and heavy metal test results</a></p>
      <a href="/science" class="text-sm text-muted-foreground hover:text-foreground">← Back to The Science</a>
    </div>
  </section>
</Layout>
