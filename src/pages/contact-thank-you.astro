---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Message Sent · Purest Electrolyte" description="Thank you for contacting Purest Electrolyte.">
  <section class="contact-thanks" aria-labelledby="thanks-title">
    <div class="thanks-content">
      <span class="thanks-check" aria-hidden="true">✓</span>
      <p class="thanks-eyebrow">Message sent</p>
      <h1 id="thanks-title">Thanks for<br />reaching out.</h1>
      <p class="thanks-description">Your message has been sent to Purest Electrolyte.<br />We will be in touch soon.</p>
      <a class="thanks-shop" href="/products">Keep shopping <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<style>
  .contact-thanks {
    display: flex;
    min-height: 70vh;
    align-items: center;
    justify-content: center;
    padding: 72px 24px 88px;
    background: #fff;
    color: #111;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .thanks-content { width: 100%; max-width: 560px; text-align: center; }
  .thanks-check { display: inline-flex; width: 48px; height: 48px; align-items: center; justify-content: center; border: 1px solid #111; border-radius: 50%; font-size: 23px; }
  .thanks-eyebrow { margin: 24px 0 0; font-size: 11px; line-height: 1.6; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
  .thanks-content h1 { margin: 20px 0 24px; font-family: inherit; font-size: clamp(44px, 5vw, 68px); line-height: 1.04; font-weight: 700; letter-spacing: -0.055em; }
  .thanks-description { margin: 0; color: #555; font-size: 16px; line-height: 1.7; }
  .thanks-shop { display: inline-flex; min-width: 232px; min-height: 56px; align-items: center; justify-content: space-between; gap: 48px; margin-top: 32px; border: 1px solid #111; border-radius: 2px; padding: 14px 20px; background: #111; color: #fff; font-size: 14px; font-weight: 500; }
  .thanks-shop span { font-size: 25px; line-height: 1; font-weight: 400; }
  .thanks-shop:hover { background: #333; }
  .thanks-shop:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
  @media (max-width: 540px) {
    .contact-thanks { min-height: 65vh; padding: 48px 24px 64px; }
    .thanks-description br { display: none; }
  }
</style>
