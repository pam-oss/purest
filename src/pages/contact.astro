---
import Layout from "@/layouts/Layout.astro";

const contactEmail = "drink@purestelectrolyte.com";
---

<Layout title="Contact · Purest Electrolyte" description="Get in touch with Purest Electrolyte.">
  <section class="contact-page" aria-labelledby="contact-title">
    <header class="contact-heading">
      <h1 id="contact-title">Get in touch.</h1>
      <a id="contact-email-address" href={'mailto:' + contactEmail}>{contactEmail}</a>
    </header>

    <form
      id="contact-form"
      class="contact-form"
      action="https://formspree.io/f/xgaewbzw"
      method="POST"
      accept-charset="UTF-8"
      aria-describedby="contact-status"
      aria-busy="false"
    >
      <input type="hidden" name="_subject" value="New message from the Purest website" />

      <div class="contact-fields-row">
        <div class="contact-field">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" maxlength="120" />
        </div>
        <div class="contact-field">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" required autocomplete="email" maxlength="254" />
        </div>
      </div>

      <div class="contact-field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" required rows="6" maxlength="5000"></textarea>
      </div>

      <button id="contact-submit" class="contact-submit" type="submit">
        <span id="contact-submit-label">Send message</span>
      </button>
      <p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<style>
  .contact-page {
    width: 100%;
    max-width: 688px;
    margin: 0 auto;
    padding: 64px 24px 80px;
    background: #fff;
    color: #111;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .contact-heading { margin-bottom: 40px; text-align: center; }
  .contact-heading h1 {
    margin: 0;
    font-family: inherit;
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.045em;
  }
  .contact-heading a {
    display: inline-block;
    max-width: 100%;
    margin-top: 14px;
    overflow-wrap: anywhere;
    color: #555;
    font-size: 14px;
    line-height: 1.6;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .contact-heading a:hover { color: #111; text-decoration-line: underline; }
  .contact-form { display: grid; gap: 24px; }
  .contact-fields-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .contact-field { display: grid; gap: 9px; min-width: 0; }
  .contact-field label { font-size: 13px; line-height: 1.5; font-weight: 500; }
  .contact-field input, .contact-field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    border: 1px solid #8f8f8f;
    border-radius: 2px;
    padding: 14px 15px;
    background: #fff;
    color: #111;
    font-family: inherit;
    font-size: 16px;
    line-height: 1.5;
    transition: border-color 150ms ease;
  }
  .contact-field input { min-height: 54px; }
  .contact-field textarea { min-height: 174px; resize: vertical; }
  .contact-field input:hover, .contact-field textarea:hover { border-color: #111; }
  .contact-field input:focus-visible, .contact-field textarea:focus-visible,
  .contact-submit:focus-visible, .contact-heading a:focus-visible { outline: 2px solid #111; outline-offset: 4px; }
  .contact-submit {
    display: flex;
    width: 100%;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    border: 1px solid #111;
    border-radius: 2px;
    padding: 14px 20px;
    background: #111;
    color: #fff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    transition: background 150ms ease;
  }
  .contact-submit:hover { background: #333; }
  .contact-submit:disabled { cursor: wait; opacity: 0.6; }
  .contact-status { margin: -8px 0 0; color: #555; font-size: 12px; line-height: 1.6; }
  .contact-status:empty { display: none; }
  .contact-form[data-state="error"] .contact-status { border-left: 2px solid #111; padding-left: 12px; color: #111; }
  @media (max-width: 540px) {
    .contact-page { padding: 40px 24px 56px; }
    .contact-heading { margin-bottom: 32px; }
    .contact-fields-row { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .contact-field input, .contact-field textarea, .contact-submit { transition: none; } }
</style>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('contact-submit-label');
  const contactStatus = document.getElementById('contact-status');
  const emailAddress = document.getElementById('contact-email-address')?.textContent?.trim() ?? '';

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    contactForm.setAttribute('aria-busy', 'true');
    contactForm.dataset.state = 'sending';
    if (submitButton) submitButton.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Sending…';
    if (contactStatus) contactStatus.textContent = 'Sending your message…';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        body: new FormData(contactForm),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error('Form submission failed');
      window.location.assign('/contact-thank-you');
    } catch {
      contactForm.setAttribute('aria-busy', 'false');
      contactForm.dataset.state = 'error';
      if (contactStatus) contactStatus.textContent = 'Your message could not be sent. Please try again or email ' + emailAddress + '.';
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Send message';
    }
  });
</script>
