---
import Layout from "@/layouts/Layout.astro";
import Newsletter from "@/components/Newsletter.tsx";
---

<Layout
  title="About · Purest Electrolyte"
  description="Why Pam started Purest Electrolyte."
>
  <article class="container max-w-2xl py-20 md:py-28">
    <h1 class="font-serif text-4xl tracking-tight md:text-5xl">Our story</h1>

    <div class="mt-10 mb-12 overflow-hidden rounded-sm aspect-[4/3]">
      <img
        src="/images/founder.jpg"
        alt="Pam Sweeney, founder of Purest Electrolyte, on the beach"
        class="h-full w-full object-cover" style="object-position: center 22%"
      />
    </div>

    <div class="prose mt-10 space-y-6 text-base leading-relaxed text-foreground/85">
      <p>
        We all have a spark in us, and we want to keep that spark alive.
      </p>
      <p>
        We want to inspire people to choose their health and give their bodies what they need to keep going, so they can keep doing the things they love.
      </p>
      <p>
        That’s why I created Purest Electrolyte. Real fruit. Real salt. No fake flavors or unnecessary ingredients. Just something simple that helps your body feel good and keep going.
      </p>
      <p>
        Because when you feel good in your body, you have the freedom to do more of what you love.
      </p>
      <p>
        We want you to go for it in your life.
      </p>
    </div>

    <hr class="my-16 border-border/60" />

    <section>
      <h2 class="font-serif text-2xl tracking-tight">Stay in the loop</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        New flavors, restocks, and the occasional letter from Pam.
      </p>
      <div class="mt-6">
        <Newsletter client:load />
      </div>
    </section>
  </article>
</Layout>
