---
import Layout from "@/layouts/Layout.astro";
import SaleBanner from "@/components/SaleBanner.astro";
import Hero from "@/components/Hero.astro";
import HomeProductCards from "@/components/HomeProductCards.astro";
import SubscriptionCTA from "@/components/SubscriptionCTA.astro";
import Testimonials from "@/components/Testimonials.astro";
import { getProducts } from "@/lib/shopify";
import FounderStory from "@/components/FounderStory.astro";
import Comparison from "@/components/Comparison.astro";
import StatsBar from "@/components/StatsBar.astro";
import PressBar from "@/components/PressBar.astro";
import { HOME_TITLE } from "@/lib/page-title";
import { FLAVOR_GROUPS } from "@/lib/flavors";
import { displayProductTitle } from "@/lib/product-title";
import type { Product } from "@/lib/shopify";

const products = await getProducts();

function findProduct(handle: string): Product | undefined {
  return products.find((product) => product.handle === handle);
}

// Subject box of the current white packshot, as fractions of that image.
// Used to place every jar scene and the kit pouch at the same size and center.
const PACK_FRAMES: Record<string, { l: number; t: number; r: number; b: number }> = {
  "10-count-ginger-limeaid": { l: 0.0606, t: 0.1746, r: 0.8963, b: 0.8684 },
  "10-count-hibiscus-lime": { l: 0.0463, t: 0.2185, r: 0.9139, b: 0.9027 },
  "10-count-chocolate-cordyceps-1": { l: 0.0279, t: 0.2145, r: 0.9282, b: 0.9091 },
  "10-servings-cranberry": { l: 0.0383, t: 0.1978, r: 0.9282, b: 0.8748 },
  "10-serving-passion-cherry": { l: 0.055, t: 0.2448, r: 0.9139, b: 0.9011 },
  "5-day-hydration-kit": { l: 0.074, t: 0.038, r: 0.902, b: 0.964 },
};

const flavorItems = FLAVOR_GROUPS.flatMap((group) => {
  const product = findProduct(group.handles[10]);
  if (!product) return [];
  return [{
    product,
    name: group.name,
    href: `/products/${group.handles[10]}`,
    frame: PACK_FRAMES[group.handles[10]],
  }];
});

const moreHandles = [
  { handle: "5-day-hydration-kit", label: "Five Day Hydration Kit", fit: "pack" as const },
  { handle: "the-hydration-ritual-kit", label: "Hydration Ritual Kit", fit: "cover" as const },
  { handle: "free-purest-glass-water-bottle", label: "Glass water bottle", fit: "cover" as const },
];

const moreItems = moreHandles.flatMap(({ handle, label, fit }) => {
  const product = findProduct(handle);
  if (!product) {
    console.warn(`Homepage product missing from Shopify: ${label} (${handle})`);
    return [];
  }
  return [{
    product,
    name: displayProductTitle(product.title),
    href: `/products/${handle}`,
    fit,
    frame: PACK_FRAMES[handle],
  }];
});

const missing = moreHandles.filter(({ handle }) => !findProduct(handle)).map(({ label, handle }) => `${label} (${handle})`);
const missingFlavors = FLAVOR_GROUPS.filter((group) => !findProduct(group.handles[10])).map((group) => group.name);
if (missing.length || missingFlavors.length) {
  console.warn("Homepage catalog gaps:", [...missingFlavors, ...missing].join("; "));
}
---

<Layout
  title={HOME_TITLE}
  description="Purest is a real fruit electrolyte in a clear glass jar, made with freeze dried fruit and French gray sea salt with no natural flavors."
>
  <SaleBanner />
  <Hero />

  <section id="flavors" class="container py-16 md:py-24">
    <h2 class="font-serif text-3xl tracking-tight md:text-4xl">Shop Purest</h2>
    <div class="mt-10">
      <HomeProductCards items={flavorItems} />
    </div>
    {moreItems.length > 0 && (
      <div class="mt-14">
        <h3 class="text-xs uppercase tracking-widest text-muted-foreground">Kits and accessories</h3>
        <div class="mt-6">
          <HomeProductCards items={moreItems} columns="three" />
        </div>
      </div>
    )}
  </section>

  <Comparison />
  <StatsBar />

  <section class="container py-16 md:py-24">
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <img
        src="/images/blog/pam-sweeney-salt-farmer-france.webp"
        alt="Pam, the founder, with one of our salt farmers beside sea salt in Guérande, France"
        width="1199"
        height="1600"
        class="aspect-[4/5] w-full object-cover object-[50%_20%]"
        loading="eager"
      />
      <div>
        <p class="text-xs uppercase tracking-widest text-muted-foreground">Sourcing</p>
        <h2 class="mt-3 font-serif text-3xl tracking-tight md:text-4xl">Real fruit and sea salt</h2>
        <p class="mt-4 text-base leading-relaxed text-foreground/75">
          Most electrolyte drinks use cheap, processed table salt. We don't. We use French gray sea salt.
        </p>
        <p class="mt-3 text-base leading-relaxed text-foreground/75">
          Purest combines real freeze dried fruit with French gray sea salt and packages it in clear glass, so you can see what you are drinking.
        </p>
        <div class="mt-6 flex flex-col gap-2 text-sm font-medium">
          <a href="/why-french-gray-sea-salt" class="underline underline-offset-4">Why French gray sea salt</a>
          <a href="/real-ingredients" class="underline underline-offset-4">Real ingredients</a>
          <a href="/science/sea-salt-heavy-metal-test-results" class="underline underline-offset-4">Sea salt test results</a>
        </div>
      </div>
    </div>
  </section>

  <FounderStory />
  <Testimonials />
  <PressBar />

  <section class="container py-16 md:py-24">
    <p class="text-xs uppercase tracking-widest text-muted-foreground">Learn</p>
    <h2 class="mt-3 font-serif text-3xl tracking-tight md:text-4xl">Science and education</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <a href="/science/sea-salt-heavy-metal-test-results" class="flex h-full flex-col border border-black/15 bg-white">
        <img src="/images/blog/pam-sweeney-salt-farmer-france.webp" alt="Pam, the founder, with one of our salt farmers beside sea salt in Guérande, France" class="aspect-video w-full object-cover object-[50%_20%]" loading="eager" />
        <span class="block p-5 font-serif text-xl leading-snug tracking-tight">Purest Electrolyte Sea Salt Test Results</span>
      </a>
      <a href="/science/trace-minerals-in-electrolytes" class="flex h-full flex-col border border-black/15 bg-white">
        <img src="https://cdn.shopify.com/s/files/1/0658/9864/3644/files/guerande-traditional-sea-salt-harvest.jpg?v=1794238729" alt="Traditional salt farmer raking sea salt in Guérande, France" class="aspect-video w-full object-cover" loading="eager" />
        <span class="block p-5 font-serif text-xl leading-snug tracking-tight">Trace Minerals in Electrolytes: More Than Just Salt</span>
      </a>
      <a href="/science/electrolyte-in-a-glass-jar" class="flex h-full flex-col border border-black/15 bg-white">
        <img src="/images/blog/purest-electrolyte-clear-glass-jars.jpg" alt="Five flavors of Purest Electrolyte powder in clear glass jars" class="aspect-video w-full object-cover" loading="eager" />
        <span class="block p-5 font-serif text-xl leading-snug tracking-tight">Why We Put Purest Electrolyte Powder in a Clear Glass Jar</span>
      </a>
    </div>
    <a href="/science" class="mt-8 inline-block text-sm font-medium underline underline-offset-4">Read the science</a>
  </section>

  <SubscriptionCTA />
</Layout>
